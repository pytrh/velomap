<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for the Velomap backend.
  Maven is Java's build tool: this file names the project, picks the Java
  version, and lists the libraries it needs. The "parent" is Spring Boot, which
  fixes compatible versions for every Spring library so we don't list them.
  Run it with ./mvnw (the Maven wrapper), so nothing needs installing globally.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>fr.josephsong</groupId>
	<artifactId>velomap</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>velomap</name>
	<description>Cycling route planner backend</description>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<!-- Web server (embedded Tomcat), REST controllers, JSON, and RestClient -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
